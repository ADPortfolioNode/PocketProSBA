{
  // GitHub Codespaces / VS Code dev container for PocketPro:SBA
  // (React frontend, Flask backend, ChromaDB, Gemini).
  "name": "PocketPro:SBA",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [3000, 5000, 8000],
  "portsAttributes": {
    "3000": { "label": "Frontend (docker compose)", "onAutoForward": "openPreview" },
    "5000": { "label": "Backend API (/api)" },
    "8000": { "label": "ChromaDB" }
  },
  // Set GEMINI_API_KEY as a Codespaces secret (GitHub → Settings → Codespaces → Secrets).
  // It arrives as an environment variable; never commit a key.
  "secrets": {
    "GEMINI_API_KEY": {
      "description": "Google Gemini API key. Required by start.sh for LLM features.",
      "documentationUrl": "https://aistudio.google.com/app/apikey"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "GitHub.vscode-pull-request-github"
      ]
    }
  }
}
