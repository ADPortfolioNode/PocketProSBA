
# Server Configuration
PORT=5000
FLASK_ENV=production
DEBUG=False
TESTING=False

# Database
DATABASE_URL=sqlite:///app.db

# Security - REQUIRED FOR PRODUCTION
SECRET_KEY=your_secure_random_secret_key_here

# API Keys - REQUIRED
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Frontend URL (for CORS)
# Use http://localhost:3000 for local dev or http://frontend:80 in Docker Compose.
FRONTEND_URL=http://localhost:3000

# Python Configuration
PYTHONUNBUFFERED=1

# LLM provider chain (see backend/services/llm_chain.py): Gemini -> Groq ->
# Ollama (only if OLLAMA_ENABLED) -> retrieved text. Never commit real keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1:8b
