# PocketPro:SBA environment template. Copy to .env and fill in real values.
# Placeholders only: never commit a real key to this file (the repo is public).
# See DEPLOY.md for what each production variable does.

# --- Required in production ------------------------------------------------
# FLASK_ENV=production makes SECRET_KEY mandatory (the app refuses to start
# without it). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# Gemini (Google AI Studio) key for chat / RAG answers
GEMINI_API_KEY=replace-with-your-gemini-api-key

# --- Web / CORS ----------------------------------------------------------------
# Public URL of the frontend; always allowed as a CORS origin.
FRONTEND_URL=http://localhost:3000
# Extra allowed CORS origins, comma-separated (e.g. a Vercel preview domain).
CORS_ALLOWED_ORIGINS=
# Reverse proxies in front of the app whose X-Forwarded-For is trusted.
# Set 1 behind Fly/Render/Vercel rewrites/the compose nginx; 0 only when
# clients reach gunicorn directly (wrong values break per-client rate limits).
TRUSTED_PROXY_COUNT=0

# --- Limits --------------------------------------------------------------------
# Max request body in bytes (uploads included). 16 MB.
MAX_CONTENT_LENGTH=16777216
# Rate limiting (Flask-Limiter). memory:// is per process: with more than one
# gunicorn worker (the Procfile runs 2) or machine, use Redis so they share
# counters, e.g. redis://default:<password>@host:6379/0
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_AUTH=10 per minute;100 per hour
RATELIMIT_LLM=30 per minute;500 per hour

# --- Database ------------------------------------------------------------------
# SQLAlchemy URL. SQLite is fine for one machine with a persistent volume;
# use Postgres for anything shared, e.g. postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///pocketpro.db

# --- ChromaDB (server must match the chromadb==0.4.24 client) ------------------
# Use CHROMADB_*; do not set CHROMA_DB_IMPL (it breaks chromadb 0.4+).
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# --- Server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
# Debug stays off in every environment unless FLASK_DEBUG=1 (or DEBUG=1).
# Never enable in production: debug logs password-reset tokens.
FLASK_DEBUG=0
# Password reset delivery is an app.config hook, not an env var:
# app.config["PASSWORD_RESET_DELIVERY"] = callable(email, token). See DEPLOY.md.
LOG_LEVEL=INFO

# --- Optional tuning -----------------------------------------------------------
LLM_MODEL=gemini-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
UPLOAD_FOLDER=./uploads
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DEFAULT_TOP_K=3
MIN_RELEVANCE_SCORE=0.7
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false
