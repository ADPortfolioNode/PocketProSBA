{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "cd frontend && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    { "source": "/browse", "destination": "/resources.html" },
    { "source": "/resources", "destination": "/resources.html" },
    { "source": "/sba", "destination": "/programs.html" },
    { "source": "/programs", "destination": "/programs.html" },
    { "source": "/((?!api/|static/).*)", "destination": "/index.html" }
  ]
}
